; Engine configuration file.
config_version=5

[application]
config/name="Ma Ville Monde"
config/description="Jeu style Toca Boca — 100% offline"
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=800
window/size/viewport_height=480
window/size/mode=2
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=0
2d/snap/snap_2d_transforms_to_pixel=true

[physics]
common/physics_ticks_per_second=60

[autoload]
Services="*res://systems/services.gd"
GestionnaireScenes="*res://scenes/commun/gestionnaire_scenes.gd"

[input_devices]
pointing/emulate_touch_from_mouse=true
